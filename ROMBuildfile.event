#ifdef _FE8_
    #include "EAstdlib.event"
    #include "CustomDefinitions.event"
        
    //PROTECT $25224
    ORG FreeSpace
        
        //Text first for Text ID definitions
        #include "repointedTextTable.event"
        #include "Text/InstallTextData.event"
        MESSAGE Used text space ends at currentOffset

        //Definitions
        #include "Maps/MapMacros.event" 
        #include "Maps/Definitions.event"

        //Graphics
        #include "Graphics/GraphicsInstaller.event"
        MESSAGE Used GFX space ends at currentOffset

        #ifdef EphraimLord_Anim
            MESSAGE WHY NOT A BRILLIANT BOY
        #endif
        //CSV tables
            #include "Tables/StatBoosts.event"
        #include "Tables/TableInstaller.event"
        MESSAGE Used table space ends at currentOffset

        //Engine Hacks
        #include "EngineHacks/_MasterHackInstaller.event"
        MESSAGE Used hax space ends at currentOffset

        //Maps
        #include "Maps/MapTables.event"
        #include "Maps/Master Map Installer.event" //NO SPACESS!!!

        

        //Events
        #include "Events/Chapter Events Installer.event"
    	// #ifdef USE_TEST_MAP
        // 
        //     #include "Events/Release_map.event"
        //     #include "Events/WorldMapEvents.event"
        // #endif // USE_TEST_MAP
        #ifdef SkillsDebug
            MESSAGE TEST SUCCESS BOI
        #endif
	//
	ASSERT (FreeSpaceEnd - currentOffset) // So that you don't overwrite vanilla tables if using default freespace
	
    MESSAGE Used free space ends at currentOffset
#else
    ERROR "You are not assembling FE8 events!"
#endif
