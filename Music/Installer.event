
#include "drumfix_fe8.event"
ALIGN 4
voicegroup000:
#incbin "FE8_NI_Map_2.bin"

PUSH //sets the title screen bgm to null
ORG $C5C9C
BYTE 0
POP

//Macro
//#define SongTableOffset  0x224470
#define SongTableOffset  0x224470
#define SongTable(index,SongPointer,Group) "PUSH; ORG SongTableOffset+(8*index); POIN SongPointer; SHORT Group Group; POP"

#define BattleMusicGroup 0
#define MapMusicGroup 1
#define SFXGroup 6

#include "MusicEvents/core.event"
SongTable(Core_UT,CORE,MapMusicGroup)

#include "MusicEvents/grasp.event"
SongTable(GraspAtVictory_FE8,GRASP,MapMusicGroup)

#include "MusicEvents/hollowlight.event"
SongTable(HollowLight_Trails,HollowLightOfTheSealedLand,MapMusicGroup)

#include "MusicEvents/man.event"
SongTable(MysteryMan,MAN,MapMusicGroup)