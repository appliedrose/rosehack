//use braces here to avoid name conflicts. If you don't know what that means, surround all #includes in this files in braces like done below.

	//Fixes the world map chapter ID being loaded instead of the actual chapter ID.
	PUSH
	ORG 0x897B2
	BYTE 0x0 0x0 0x0 0x0
	POP

	//Fixes the game considering some chapters postgame.
	// This part was not in essential fixes. >:(
	PUSH 
	ORG 0x897C4
	BYTE 0x0E 0x20 0x20 0x56
	POP

	// Skip the magvel lore dump at the start of a new save file

	#ifdef SkipVanillaPrologueLoreDump
		PUSH
			ORG $A39768
			EVBIT_MODIFY 0x1
			SKIPWN
			ENDA
		POP
	#endif

{
#include "ExampleChapter.event"
}
{
#include "RosieTestChapter.event"
}
{
#include "EggRoom.event"
}